# --- Django ---
APP_DEBUG=False
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_ADMIN_CODE=change-me-too

# --- Database ---
# Postgres connection string. Leave unset to fall back to local SQLite.
DATABASE_URL=postgres://norecipes:norecipes@db:5432/norecipes

# --- File storage ---
# Set APP_USE_S3=true and provide AWS_* values to use S3-compatible storage.
APP_USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Endpoint URL: empty for AWS S3, custom value for S3-compatible providers (e.g. MinIO).
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# --- Logging ---
APP_LOG_LEVEL=INFO
# Dotted path to a logging.Handler subclass.
APP_LOG_HANDLER=logging.StreamHandler
# JSON dict of constructor kwargs for the handler.
APP_LOG_HANDLER_OPTIONS={}

# --- Email ---
# 'console' writes messages to stdout, 'smtp' delivers via the configured SMTP server.
APP_EMAIL_BACKEND=console
APP_EMAIL_HOST=
APP_EMAIL_PORT=587
APP_EMAIL_HOST_USER=
APP_EMAIL_HOST_PASSWORD=